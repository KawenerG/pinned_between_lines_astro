---
const { title = "Pinned Between Lines" } = Astro.props;
import { base } from "../utils/env";
import Header from "../components/Header.astro";
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>{title}</title>
    <link rel="stylesheet" href={`${base}/styles/review-layout.css`} />
    <link rel="stylesheet" href={`${base}/styles/header.css`} />
    <link rel="icon" href={`${base}/favicon.ico`} type="image/x-icon" />
  </head>
  <body>
    <Header />
    <slot />
  </body>
</html>